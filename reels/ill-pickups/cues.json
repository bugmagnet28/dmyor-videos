 "sentences": [
  {
   "s": 0.0,
   "e": 3.06,
   "text": "Your screen time isn't the real problem, your pickups are."
  },
  {
   "s": 3.2,
   "e": 5.9,
   "text": "And your phone already tells you which app keeps pulling you back."
  },
  {
   "s": 6.3,
   "e": 7.34,
   "text": "Most people never look."
  },
  {
   "s": 7.72,
   "e": 12.5,
   "text": "Open screen time on an iPhone or digital wellbeing on Android and find pickups or unlocks."
  },
  {
   "s": 13.06,
   "e": 14.12,
   "text": "Say it says 90 a day."
  },
  {
   "s": 14.5,
   "e": 16.16,
   "text": "That's 90 times you didn't decide."
  },
  {
   "s": 16.62,
   "e": 19.52,
   "text": "If each one costs you two minutes, that's three hours gone in pieces."
  },
  {
   "s": 20.12,
   "e": 22.3,
   "text": "Now scroll down to first used after pickup."
  },
  {
   "s": 22.78,
   "e": 25.5,
   "text": "That's the app your thumb opens before you've even thought about it."
  },
  {
   "s": 25.76,
   "e": 26.58,
   "text": "Say it's Instagram."
  },
  {
   "s": 27.16,
   "e": 28.36,
   "text": "So what do you do with it?"
  },
  {
   "s": 28.36,
   "e": 32.7,
   "text": "Step one, move that one app off your home screen into a folder on the last page."
  },
  {
   "s": 33.1,
   "e": 35.04,
   "text": "Not deleted, just three swipes away."
  },
  {
   "s": 35.68,
   "e": 38.68,
   "text": "Step two, turn off its notifications so it stops calling you."
  },
  {
   "s": 39.06,
   "e": 42.68,
   "text": "The phone stays, but now there's a pause and the pause is where you get to decide."
  },
  {
   "s": 43.26,
   "e": 45.08,
   "text": "Check your pickups again in seven days."
  },
  {
   "s": 45.64,
   "e": 48.44,
   "text": "Here's the reset, find your first app, move it off page one,"
  },
  {
   "s": 48.68,
   "e": 50.3,
   "text": "mute it and check again on day seven."
  },
  {
   "s": 50.78,
   "e": 53.08,
   "text": "Send this to the friend who checks their phone mid-sentence."
  },
  {
   "s": 53.48,
   "e": 54.76,
   "text": "That's what Demure is for."
  },
  {
   "s": 54.76,
   "e": 57.64,
   "text": "You archive your dream today so you can see it tomorrow"
  },
  {
   "s": 57.64,
   "e": 60.44,
   "text": "and break it down into small steps you can actually do."
  },
  {
   "s": 60.78,
   "e": 64.42,
   "text": "Follow for one fix a day, tonight the coffee that's still in you at bedtime."
  },
  {
   "s": 64.88,
   "e": 67.38,
   "text": "If you want to try it out, I've put the link in the bio."
  }
 ],
