 "sentences": [
  {
   "s": 0.0,
   "e": 2.34,
   "text": "Four months from today, it is January."
  },
  {
   "s": 3.26,
   "e": 8.86,
   "text": "What is different if you actually do the thing you keep telling yourself you will do, not"
  },
  {
   "s": 8.86,
   "e": 11.14,
   "text": "the big version of it, the small one?"
  },
  {
   "s": 11.8,
   "e": 15.46,
   "text": "Twenty minutes a day, one page, one phone call."
  },
  {
   "s": 16.08,
   "e": 18.62,
   "text": "Four months is about 120 days."
  },
  {
   "s": 19.36,
   "e": 22.74,
   "text": "A hundred and twenty days of almost anything changes something."
  },
  {
   "s": 23.3,
   "e": 24.74,
   "text": "The work is not the hard part."
  },
  {
   "s": 24.74,
   "e": 29.32,
   "text": "The hard part is that in three weeks you will not remember you said this."
  },
  {
   "s": 29.92,
   "e": 31.32,
   "text": "So here is the whole method."
  },
  {
   "s": 31.9,
   "e": 33.58,
   "text": "It takes five minutes to set up."
  },
  {
   "s": 33.94,
   "e": 35.76,
   "text": "Write one sentence, not a feeling."
  },
  {
   "s": 36.28,
   "e": 39.04,
   "text": "A sentence someone else could check, not get fit."
  },
  {
   "s": 39.54,
   "e": 44.26,
   "text": "Walk to 30 minutes, then pick the smallest version that still counts on a bad day."
  },
  {
   "s": 44.76,
   "e": 48.24,
   "text": "If your normal is an hour, your bad day is 10 minutes."
  },
  {
   "s": 48.64,
   "e": 49.72,
   "text": "10 minutes still counts."
  },
  {
   "s": 50.26,
   "e": 52.18,
   "text": "Then mark it, every single day."
  },
  {
   "s": 52.18,
   "e": 57.16,
   "text": "On paper, on a wall, anywhere you will see it without going to look for it."
  },
  {
   "s": 57.4,
   "e": 58.12,
   "text": "You will miss days."
  },
  {
   "s": 58.76,
   "e": 59.76,
   "text": "Everyone misses days."
  },
  {
   "s": 60.28,
   "e": 61.94,
   "text": "The only rule that matters is this."
  },
  {
   "s": 62.46,
   "e": 63.26,
   "text": "Never miss twice."
  },
  {
   "s": 63.88,
   "e": 66.46,
   "text": "At 30 days, it stops feeling like a decision."
  },
  {
   "s": 66.94,
   "e": 69.58,
   "text": "At 60, you stop noticing you are doing it."
  },
  {
   "s": 69.9,
   "e": 73.34,
   "text": "At 120, you are just someone who does this."
  },
  {
   "s": 74.1,
   "e": 75.42,
   "text": "That is the whole thing."
  },
  {
   "s": 76.02,
   "e": 77.28,
   "text": "Write the sentence tonight."
  },
  {
   "s": 77.28,
   "e": 83.08,
   "text": "In January, you will either have it or you will have the same sentence you have now."
  }
 ],
 "wps": 2.77
}